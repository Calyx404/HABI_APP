{
  "name": "habi-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "npm run build && firebase deploy --only functions,firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
