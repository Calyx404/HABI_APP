{
  "name": "habi-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "set-admin": "node scripts/set-admin-claim.cjs",
    "revoke-admin": "node scripts/revoke-admin-claim.cjs",
    "migrate-employer-verification": "node scripts/migrate-employer-verification.cjs",
    "test:rules": "firebase --project demo-habi-rules-test --config ../firebase.rules-test.json emulators:exec --only firestore \"node --test test/firestore.rules.test.mjs\"",
    "deploy": "npm run build && firebase deploy --only functions,firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
