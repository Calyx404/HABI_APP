rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function roleAfter(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isEmployer() {
      return signedIn() && roleOf(request.auth.uid) == 'employer';
    }

    function isEmployerAfter() {
      return signedIn() && roleAfter(request.auth.uid) == 'employer';
    }

    function isJobSeeker() {
      return signedIn() && roleOf(request.auth.uid) == 'jobSeeker';
    }

    function isConversationParticipant(data) {
      return signedIn() && request.auth.uid in data.participantIds;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['jobSeeker', 'employer']
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'profileComplete', 'visibility',
          'createdAt', 'updatedAt', 'firstName', 'middleName', 'lastName',
          'suffix', 'birthDate', 'sex', 'genderIdentity', 'mobile', 'address',
          'cityProvince', 'barangay', 'beneficiaryCategories',
          'shareBeneficiary', 'education', 'skills', 'workExperience',
          'employmentType', 'workArrangement', 'preferredLocation',
          'availabilityDays', 'availabilityTime', 'accessibility',
          'shareAccessibility', 'accessibilityDetails', 'resumeName', 'resumeStoragePath', 'profileDone',
          'phone', 'companyName'
        ]);
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'profileComplete', 'visibility',
          'createdAt', 'updatedAt', 'firstName', 'middleName', 'lastName',
          'suffix', 'birthDate', 'sex', 'genderIdentity', 'mobile', 'address',
          'cityProvince', 'barangay', 'beneficiaryCategories',
          'shareBeneficiary', 'education', 'skills', 'workExperience',
          'employmentType', 'workArrangement', 'preferredLocation',
          'availabilityDays', 'availabilityTime', 'accessibility',
          'shareAccessibility', 'accessibilityDetails', 'resumeName', 'resumeStoragePath', 'profileDone',
          'phone', 'companyName'
        ]);
      allow delete: if false;

      match /saved_jobs/{jobId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.jobId == jobId
          && exists(/databases/$(database)/documents/jobs/$(jobId))
          && get(/databases/$(database)/documents/jobs/$(jobId)).data.status == 'published';
      }

      match /notifications/{notificationId} {
        allow get, list: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }

      match /settings/{settingsId} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && settingsId == 'preferences'
          && request.resource.data.keys().hasOnly([
            'jobAlerts', 'applicationUpdates', 'messages', 'trainingReminders',
            'darkMode', 'updatedAt'
          ]);
        allow delete: if false;
      }
    }

    match /support_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'subject', 'message', 'status', 'createdAt'
        ]);
      allow get, list: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /seeker_profiles/{uid} {
      allow get, list: if signedIn()
        && (request.auth.uid == uid
          || (isEmployer() && resource.data.visibility == true));
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'education', 'skills', 'workExperience',
          'employmentType', 'workArrangement', 'preferredLocation',
          'availabilityDays', 'availabilityTime', 'beneficiaryCategories',
          'accessibility', 'accessibilityDetails', 'shareBeneficiary', 'shareAccessibility',
          'visibility', 'profileComplete', 'createdAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /employer_profiles/{uid} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      // New employer accounts write users/{uid} and employer_profiles/{uid}
      // in one batch. Use getAfter so this rule can verify the role being
      // created in that same atomic write.
      allow create: if signedIn()
        && request.auth.uid == uid
        && isEmployerAfter()
        && request.resource.data.keys().hasOnly([
          'uid', 'companyName', 'organizationType', 'industry', 'email',
          'contactFirstName', 'contactLastName', 'position', 'phone',
          'address', 'city', 'description', 'businessRegistrationType',
          'businessRegistrationNumber', 'supportingDocumentName',
          'supportingDocumentStoragePath', 'employerWebsite',
          'verificationEmail', 'profileComplete', 'displayName', 'visibility',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid;
      allow update: if signedIn()
        && request.auth.uid == uid
        && isEmployer()
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'companyName', 'organizationType', 'industry', 'email',
          'contactFirstName', 'contactLastName', 'position', 'phone',
          'address', 'city', 'description', 'businessRegistrationType',
          'businessRegistrationNumber', 'supportingDocumentName',
          'supportingDocumentStoragePath', 'employerWebsite',
          'verificationEmail', 'profileComplete', 'displayName', 'visibility',
          'createdAt', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /jobs/{jobId} {
      allow get, list: if signedIn()
        && (resource.data.status == 'published'
          || resource.data.ownerId == request.auth.uid);
      allow create: if isEmployer()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120;
      allow update: if isEmployer()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status in ['draft', 'published', 'closed', 'archived'];
      allow delete: if false;
    }

    match /applications/{applicationId} {
      allow get, list: if signedIn()
        && (resource.data.applicantId == request.auth.uid
          || (isEmployer() && resource.data.employerId == request.auth.uid));
      allow create: if isJobSeeker()
        && applicationId == request.resource.data.jobId + '_' + request.auth.uid
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.status == 'Under Review'
        && request.resource.data.jobId is string
        && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId))
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'published'
        && request.resource.data.employerId
          == get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.ownerId;
      allow update: if isEmployer()
        && resource.data.employerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'statusTitle', 'statusMessage', 'updatedAt'
        ])
        && request.resource.data.status in ['Under Review', 'Interview', 'Hired', 'Not Selected'];
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get, list: if isConversationParticipant(resource.data);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.auth.uid in [
          request.resource.data.posterId,
          request.resource.data.applicantId
        ]
        && request.resource.data.participantIds.hasAll([
          request.resource.data.posterId,
          request.resource.data.applicantId
        ])
        && request.resource.data.participantIds.size() == 2
        && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId))
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.ownerId
          == request.resource.data.posterId
        && (
          (request.auth.uid == request.resource.data.applicantId
            && isJobSeeker()
            && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'published')
          || (exists(/databases/$(database)/documents/applications/$(request.resource.data.jobId + '_' + request.resource.data.applicantId))
            && get(/databases/$(database)/documents/applications/$(request.resource.data.jobId + '_' + request.resource.data.applicantId)).data.employerId
              == request.resource.data.posterId)
        );
      allow update: if isConversationParticipant(resource.data)
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageText', 'lastMessageSenderId', 'lastMessageAt',
          'lastReadCount', 'clearedBefore', 'archivedFor'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessageSenderId'])
          || request.resource.data.lastMessageSenderId == request.auth.uid);
      allow delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        allow get, list: if isConversationParticipant(parentConversation());
        allow create: if isConversationParticipant(parentConversation())
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }
  }
}
