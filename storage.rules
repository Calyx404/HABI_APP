rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userRole(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid)).data.role;
    }

    match /resumes/{uid}/{fileName} {
      allow read, write: if signedIn() && request.auth.uid == uid
        && (request.resource == null
          || (request.resource.size <= 10 * 1024 * 1024
            && request.resource.contentType == 'application/pdf'));
    }

    match /employer_documents/{uid}/{fileName} {
      allow read: if signedIn()
        && ((request.auth.uid == uid && userRole(uid) == 'employer')
          || request.auth.token.admin == true);
      allow write: if signedIn()
        && request.auth.uid == uid
        && userRole(uid) == 'employer'
        && (request.resource == null
          || (request.resource.size <= 10 * 1024 * 1024
            && request.resource.contentType in [
              'application/pdf', 'image/png', 'image/jpeg'
            ]));
    }

    match /application_resumes/{jobId}/{applicantId}/{fileName} {
      function application() {
        return firestore.get(/databases/(default)/documents/applications/$(jobId + '_' + applicantId)).data;
      }
      function applicationExists() {
        return firestore.exists(/databases/(default)/documents/applications/$(jobId + '_' + applicantId));
      }
      function submittedPathMatches() {
        return applicationExists()
          && application().resumeStoragePath
            == 'application_resumes/' + jobId + '/' + applicantId + '/' + fileName;
      }
      function jobIsPublished() {
        return firestore.exists(/databases/(default)/documents/jobs/$(jobId))
          && firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.status == 'published';
      }
      allow create: if signedIn()
        && request.auth.uid == applicantId
        && userRole(applicantId) == 'jobSeeker'
        && jobIsPublished()
        && fileName.matches('^[0-9]+\\.pdf$')
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && resource == null;
      allow update, delete: if false;
      allow read: if signedIn()
        && submittedPathMatches()
        && (request.auth.uid == applicantId
          || (userRole(request.auth.uid) == 'employer'
            && application().employerId == request.auth.uid));
    }
  }
}
